{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ocr/backend-api-v1.schema.json",
  "title": "OCR Backend API V1",
  "$defs": {
    "requestId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "cell": {
      "type": "object",
      "required": [
        "text",
        "confidence",
        "needs_review"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "confidence_sentinel": {
          "type": "boolean",
          "description": "可选。true 表示该格的 confidence 是识别路径硬写的类别哨兵（0.77 = 未取得双模型一致确认，0.86 = 已取得），不是实测置信度；消费方不应把它当成低置信告警。老客户端可忽略此字段。"
        }
      },
      "additionalProperties": true
    },
    "span": {
      "type": "object",
      "required": [
        "row",
        "column",
        "row_span",
        "column_span"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "row_span": {
          "type": "integer",
          "minimum": 1
        },
        "column_span": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "structureCertificate": {
      "type": "object",
      "required": [
        "version",
        "verified",
        "rows",
        "columns"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "verified": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "geometry_hash": {
          "type": "string"
        },
        "structure_hash": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "row_offset": {
          "type": "integer"
        },
        "column_offset": {
          "type": "integer"
        },
        "source_shape": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "column_boundaries": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "row_boundaries": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "row_column_boundaries": {
          "type": "array"
        },
        "row_column_hash": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "healthRequest": {
      "type": "object",
      "required": [
        "protocol",
        "action"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "action": {
          "const": "health"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      },
      "additionalProperties": false
    },
    "warmupRequest": {
      "type": "object",
      "required": [
        "protocol",
        "action"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "action": {
          "const": "warmup"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      },
      "additionalProperties": false
    },
    "recognizeRequest": {
      "type": "object",
      "required": [
        "protocol",
        "action",
        "image_path"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "action": {
          "const": "recognize"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "image_path": {
          "type": "string",
          "minLength": 1
        },
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "properties": {
            "crop_mode": {
              "enum": [
                "auto",
                "grid",
                "full"
              ]
            },
            "accuracy_mode": {
              "enum": [
                "adaptive",
                "adaptive_high",
                "maximum"
              ]
            },
            "deadline_seconds": {
              "type": "number",
              "minimum": 0
            },
            "input_rectified": {
              "type": "boolean"
            },
            "selected_table_region": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exportXlsxRequest": {
      "type": "object",
      "required": [
        "protocol",
        "action",
        "output_path",
        "cells"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "action": {
          "const": "export_xlsx"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "structure_certificate": {
          "$ref": "#/$defs/structureCertificate"
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "protocol",
        "status",
        "action",
        "error_code",
        "message",
        "retryable"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "status": {
          "const": "error"
        },
        "action": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "error_type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "recognizeResponse": {
      "type": "object",
      "required": [
        "protocol",
        "status",
        "action",
        "rows",
        "columns",
        "cells",
        "spans",
        "recognition_state",
        "publication_blocked",
        "publication_block_reasons",
        "structure_verified",
        "structure_certificate",
        "image_quality",
        "rectified_image"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "action": {
          "const": "recognize"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "recognition_state": {
          "enum": [
            "verified",
            "needs_review",
            "blocked"
          ]
        },
        "publication_blocked": {
          "type": "boolean"
        },
        "publication_block_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structure_verified": {
          "type": "boolean"
        },
        "structure_certificate": {
          "type": [
            "object",
            "null"
          ]
        },
        "image_quality": {
          "type": "object",
          "required": [
            "issues",
            "issue_labels",
            "needs_recapture"
          ],
          "properties": {
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "issue_labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "needs_recapture": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "rectified_image": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "review_cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "memory_mode": {
          "enum": [
            "normal",
            "low_memory"
          ]
        }
      },
      "additionalProperties": true
    },
    "healthResponse": {
      "type": "object",
      "required": [
        "protocol",
        "status",
        "action"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "action": {
          "const": "health"
        },
        "offline": {
          "type": "boolean"
        },
        "backend_version": {
          "type": "string"
        },
        "models_valid": {
          "type": "boolean",
          "description": "15 个离线模型齐全且 SHA-256 匹配"
        },
        "warmed_up": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object"
        },
        "engine": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      },
      "additionalProperties": true
    },
    "warmupResponse": {
      "type": "object",
      "required": [
        "protocol",
        "status",
        "action"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "action": {
          "const": "warmup"
        },
        "offline": {
          "type": "boolean"
        },
        "warmed_up": {
          "type": "boolean"
        },
        "engine": {
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      },
      "additionalProperties": true
    },
    "exportXlsxResponse": {
      "type": "object",
      "required": [
        "protocol",
        "status",
        "action",
        "output_path"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "action": {
          "const": "export_xlsx"
        },
        "output_path": {
          "type": "string",
          "description": "写入成功的 xlsx 路径"
        },
        "request_id": {
          "$ref": "#/$defs/requestId"
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/healthRequest"
    },
    {
      "$ref": "#/$defs/warmupRequest"
    },
    {
      "$ref": "#/$defs/recognizeRequest"
    },
    {
      "$ref": "#/$defs/exportXlsxRequest"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/recognizeResponse"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/warmupResponse"
    },
    {
      "$ref": "#/$defs/exportXlsxResponse"
    }
  ]
}
